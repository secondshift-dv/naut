<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>$(ProductRuntimeIdentifier)</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>naut</AssemblyName>
    <RootNamespace>Neuterradise.Launcher</RootNamespace>
    <ApplicationIcon>..\Neuterradise.App\Assets\Brand\app-icon.ico</ApplicationIcon>
    <Product>naut</Product>
    <AssemblyTitle>naut</AssemblyTitle>
    <Description>naut launcher</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Neuterradise.Release.Contracts\Neuterradise.Release.Contracts.csproj" />
  </ItemGroup>
</Project>
