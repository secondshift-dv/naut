{
  "id": "builtin.neuterradise.effect.cloud-veil",
  "kind": "effect",
  "name": "Cloud Veil",
  "performance": {
    "tier": "light",
    "continuousAnimation": true,
    "offscreenPolicy": "pause",
    "maxAnimatedLayers": 1
  },
  "spec": {
    "targets": [
      "all"
    ],
    "channel": "environment",
    "interactionOnly": false,
    "variants": {
      "full": {
        "layers": [
          {
            "kind": "fog",
            "opacity": 0.1,
            "color": "token:accentSecondary",
            "scale": 3,
            "speed": 0.08
          }
        ]
      },
      "reduced": {
        "layers": []
      },
      "fallback": {
        "layers": []
      }
    }
  }
}
