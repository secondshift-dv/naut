{
  "id": "builtin.neuterradise.effect.film",
  "kind": "effect",
  "name": "Film",
  "spec": {
    "targets": [
      "effect.profile.banner"
    ],
    "channel": "particles",
    "interactionOnly": false,
    "variants": {
      "full": {
        "layers": [
          {
            "kind": "noise",
            "opacity": 0.38,
            "speed": 0.6,
            "amplitude": 0.12
          },
          {
            "kind": "vignette",
            "opacity": 0.18
          }
        ]
      },
      "reduced": {
        "layers": [
          {
            "kind": "noise",
            "opacity": 0.32,
            "speed": 0,
            "amplitude": 0
          },
          {
            "kind": "vignette",
            "opacity": 0.12
          }
        ]
      },
      "fallback": {
        "layers": [
          {
            "kind": "noise",
            "opacity": 0.32,
            "speed": 0,
            "amplitude": 0
          },
          {
            "kind": "vignette",
            "opacity": 0.12
          }
        ]
      }
    }
  },
  "performance": {
    "tier": "light",
    "continuousAnimation": true,
    "offscreenPolicy": "pause",
    "maxAnimatedLayers": 2
  },
  "description": "Visible film grain and soft edge shade over the banner."
}
