            "angle": 14
          }
        ]
      },
      "reduced": {
        "layers": []
      },
      "fallback": {
        "layers": []
      }
    }
  },
  "performance": {
    "tier": "light",
    "continuousAnimation": true,
    "offscreenPolicy": "pause",
    "maxAnimatedLayers": 1
  }
}
