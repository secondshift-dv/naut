{
  "id": "builtin.neuterradise.effect.shimmer",
  "kind": "effect",
  "name": "Shimmer",
  "spec": {
    "targets": [
      "effect.profile.banner"
    ],
    "channel": "lighting",
    "interactionOnly": false,
    "variants": {
      "full": {
