{
  "id": "builtin.neuterradise.card.stats",
  "kind": "profile-card",
  "name": "Stats Card",
  "description": "Artwork plus a persistent statistics strip for collection-oriented browsing.",
  "spec": {
    "legacyVariant": "stats",
    "aspect": 1.2,
    "art": "cover",
    "density": "detailed",
    "hover": "lift",
    "frame": "none",
    "composition": {
      "type": "grid",
      "children": [
        {
          "type": "overlay",
          "children": [
            {
              "type": "image",
              "slot": "profile.identity.banner",
              "stretch": "uniform-to-fill"
            },
            {
              "type": "scrim",
              "direction": "to-top",
              "from": "token:heroScrimStrong",
              "to": "#00000000",
              "vAlign": "bottom",
              "height": 80
            },
            {
              "type": "text",
              "slot": "profile.identity.name",
              "role": "card-title",
              "color": "token:onMediaPrimary",
              "maxLines": 1,
              "vAlign": "bottom",
              "margin": 10
            },
            {
              "type": "badge",
              "slot": "profile.identity.favorite",
              "style": "glass",
              "visibleWhen": "profile.identity.favorite",
              "hAlign": "right",
              "vAlign": "top",
              "margin": 8
            }
          ]
        },
        {
          "type": "stack",
          "spacing": 3,
          "children": [
            {
              "type": "text",
              "slot": "profile.identity.category",
              "role": "micro",
              "color": "token:textSecondary",
              "maxLines": 1,
              "visibleWhen": "profile.identity.category"
            },
            {
              "type": "grid",
              "children": [
                {
                  "type": "badge",
                  "slot": "profile.statistics.media-count",
                  "style": "text",
                  "column": 0
                },
                {
                  "type": "badge",
                  "slot": "profile.statistics.related-count",
                  "style": "text",
                  "column": 1
                }
              ],
              "columns": [
                "*",
                "*"
              ],
              "spacing": 8
            },
            {
              "type": "badge",
              "slot": "profile.identity.rating",
              "style": "text",
              "visibleWhen": "profile.identity.rating",
              "hAlign": "left"
            }
          ],
          "background": "token:surface1",
          "padding": 10,
          "row": 1
        }
      ],
      "rows": [
        "*",
        "auto"
      ]
    }
  }
}
