{
  "id": "builtin.neuterradise.card.glass",
  "kind": "profile-card",
  "name": "Glass",
  "description": "Square art with a floating frosted identity strip.",
  "spec": {
    "legacyVariant": "glass",
    "aspect": 1,
    "art": "cover",
    "density": "minimal",
    "hover": "lift",
    "frame": "none",
    "composition": {
      "type": "overlay",
      "children": [
        {
          "type": "image",
          "slot": "profile.identity.cover",
          "stretch": "uniform-to-fill"
        },
        {
          "type": "badge",
          "slot": "profile.identity.favorite",
          "style": "glass",
          "visibleWhen": "profile.identity.favorite",
          "hAlign": "right",
          "vAlign": "top",
          "margin": 8
        },
        {
          "type": "stack",
          "spacing": 4,
          "children": [
            {
              "type": "text",
              "slot": "profile.identity.name",
              "role": "card-title",
              "color": "token:textPrimary",
              "maxLines": 1
            },
            {
              "type": "text",
              "slot": "profile.identity.category",
              "role": "micro",
              "color": "token:textSecondary",
              "maxLines": 1,
              "visibleWhen": "profile.identity.category"
            },
            {
              "type": "grid",
              "children": [
                {
                  "type": "text",
                  "slot": "profile.identity.tags",
                  "role": "micro",
                  "color": "token:textSecondary",
                  "maxLines": 1,
                  "visibleWhen": "profile.identity.tags",
                  "column": 0
                },
                {
                  "type": "badge",
                  "slot": "profile.identity.rating",
                  "style": "text",
                  "visibleWhen": "profile.identity.rating",
                  "column": 1
                }
              ],
              "columns": [
                "*",
                "auto"
              ],
              "spacing": 8
            }
          ],
          "vAlign": "bottom",
          "margin": 8,
          "padding": 10,
          "background": "token:glassDeepFill",
          "cornerRadius": "token:radiusCard"
        }
      ]
    }
  }
}
