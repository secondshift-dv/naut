{
  "id": "builtin.neuterradise.card.cinematic-v2",
  "kind": "profile-card",
  "name": "Cinematic",
  "description": "Artwork-first poster with a restrained identity overlay.",
  "spec": {
    "aspect": 0.7,
    "art": "cover",
    "density": "minimal",
    "hover": "spotlight",
    "frame": "none",
    "composition": {
      "type": "overlay",
      "children": [
        {
          "type": "image",
          "slot": "profile.identity.cover",
          "stretch": "uniform-to-fill"
        },
        {
          "type": "scrim",
          "direction": "to-top",
          "strength": 0.8
        },
        {
          "type": "stack",
          "vAlign": "bottom",
          "padding": 16,
          "spacing": 5,
          "children": [
            {
              "type": "text",
              "slot": "profile.identity.name",
              "role": "card-title",
              "color": "token:onMediaPrimary",
              "maxLines": 2
            },
            {
              "type": "text",
              "slot": "profile.identity.category",
              "role": "micro",
              "color": "token:onMediaSecondary"
            },
            {
              "type": "badge",
              "slot": "profile.identity.favorite",
              "style": "glass",
              "visibleWhen": "profile.identity.favorite",
              "hAlign": "left"
            }
          ]
        }
      ]
    }
  }
}
