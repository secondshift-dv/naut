{
  "id": "builtin.neuterradise.card.cinematic-tall",
  "kind": "profile-card",
  "name": "Cinematic Tall",
  "description": "Tall artwork with a strong title block.",
  "spec": {
    "legacyVariant": "cinematic-tall",
    "aspect": 0.6667,
    "art": "cover-over-banner",
    "density": "standard",
    "hover": "lift",
    "frame": "none",
    "composition": {
      "type": "overlay",
      "children": [
        {
          "type": "image",
          "slot": "profile.identity.cover",
          "stretch": "uniform-to-fill"
        },
        {
          "type": "scrim",
          "direction": "to-top",
          "from": "token:heroScrimStrong",
          "to": "#00000000",
          "vAlign": "bottom",
          "height": 128
        },
        {
          "type": "badge",
          "slot": "profile.identity.favorite",
          "style": "glass",
          "visibleWhen": "profile.identity.favorite",
          "hAlign": "right",
          "vAlign": "top",
          "margin": 8
        },
        {
          "type": "stack",
          "spacing": 4,
          "children": [
            {
              "type": "text",
              "slot": "profile.identity.name",
              "role": "card-title",
              "color": "token:onMediaPrimary",
              "maxLines": 2
            },
            {
              "type": "text",
              "slot": "profile.identity.category",
              "role": "micro",
              "color": "token:onMediaSecondary",
              "maxLines": 1,
              "visibleWhen": "profile.identity.category"
            },
            {
              "type": "text",
              "slot": "profile.identity.tags",
              "role": "micro",
              "color": "token:onMediaSecondary",
              "maxLines": 1,
              "visibleWhen": "profile.identity.tags"
            },
            {
              "type": "badge",
              "slot": "profile.identity.rating",
              "style": "glass",
              "visibleWhen": "profile.identity.rating",
              "hAlign": "left"
            }
          ],
          "vAlign": "bottom",
          "margin": 12
        }
      ]
    }
  }
}
