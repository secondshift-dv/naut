{
  "id": "builtin.neuterradise.card.poster",
  "kind": "profile-card",
  "name": "Poster",
  "description": "Cover-first poster with identity below, keeping the artwork unobstructed.",
  "spec": {
    "legacyVariant": "poster",
    "aspect": 0.6667,
    "art": "cover",
    "density": "minimal",
    "hover": "lift",
    "frame": "none",
    "composition": {
      "type": "grid",
      "children": [
        {
          "type": "overlay",
          "children": [
            {
              "type": "image",
              "slot": "profile.identity.cover",
              "stretch": "uniform-to-fill"
            },
            {
              "type": "badge",
              "slot": "profile.identity.favorite",
              "style": "glass",
              "visibleWhen": "profile.identity.favorite",
              "hAlign": "right",
              "vAlign": "top",
              "margin": 8
            }
          ]
        },
        {
          "type": "stack",
          "spacing": 3,
          "children": [
            {
              "type": "text",
              "slot": "profile.identity.name",
              "role": "card-title",
              "color": "token:textPrimary",
              "maxLines": 1
            },
            {
              "type": "text",
              "slot": "profile.identity.category",
              "role": "micro",
              "color": "token:textSecondary",
              "maxLines": 1,
              "visibleWhen": "profile.identity.category"
            },
            {
              "type": "text",
              "slot": "profile.identity.tags",
              "role": "micro",
              "color": "token:textSecondary",
              "maxLines": 1,
              "visibleWhen": "profile.identity.tags"
            },
            {
              "type": "badge",
              "slot": "profile.identity.rating",
              "style": "text",
              "visibleWhen": "profile.identity.rating",
              "hAlign": "left"
            }
          ],
          "background": "token:surface1",
          "padding": 10,
          "row": 1
        }
      ],
      "rows": [
        "*",
        "auto"
      ]
    }
  }
}
