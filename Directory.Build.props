<Project>
  <PropertyGroup>
    <ProductVersion>0.0.20</ProductVersion>
    <ProductAssemblyVersion>0.0.10.0</ProductAssemblyVersion>
    <ProductRuntimeIdentifier>win-x64</ProductRuntimeIdentifier>
    <!-- Baseline for supporting binaries. Override Version when a component's release identity changes. -->
    <Version>0.0.18</Version>
    <AssemblyVersion>$(ProductAssemblyVersion)</AssemblyVersion>
    <FileVersion>$(ProductAssemblyVersion)</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>
  </PropertyGroup>
</Project>
