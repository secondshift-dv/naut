.gitattributes text eol=lf

# Files whose exact bytes participate in packaging/licensing authority stay LF on every platform.
scripts/packaging/ffmpeg/* text eol=lf
scripts/packaging/**/*.ps1 text eol=lf
scripts/packaging/**/*.sh text eol=lf
scripts/packaging/**/*.py text eol=lf
scripts/packaging/**/*.json text eol=lf
scripts/packaging/**/*.txt text eol=lf

# Optional pack text has stable bytes across authoring and download builds.
packs/**/*.json text eol=lf
packs/**/*.txt text eol=lf
packs/**/*.md text eol=lf
packs/*.json text eol=lf
packs/*.md text eol=lf
