      "spec": {
        "aspect": 2.15,
        "art": "cover-over-banner",
        "density": "detailed",
        "hover": "spotlight",
        "frame": "none",
        "composition": {
          "type": "grid",
          "rows": [
            "1.35*",
            "*"
          ],
          "columns": [
            "*"
          ],
          "children": [
            {
              "type": "shape",
              "fill": "token:surface2"
            },
            {
              "type": "image",
              "slot": "profile.identity.banner",
              "stretch": "uniform-to-fill",
              "ambient": true,
              "fallback": "none"
            },
            {
              "type": "scrim",
              "direction": "to-bottom",
              "from": "#22DDCBB7",
              "to": "#60BC9B7C"
            },
            {
              "type": "shape",
              "fill": "token:surface1",
              "row": 1
            },
            {
              "type": "shape",
              "fill": "token:borderDefault",
              "row": 1,
              "height": 1,
              "vAlign": "top"
            },
            {
              "type": "grid",
              "columns": [
                "32",
                "*"
              ],
              "margin": [
                8,
                2
              ],
              "vAlign": "center",
              "spacing": 6,
              "children": [
                {
                  "type": "overlay",
                  "vAlign": "center",
                  "height": 30,
                  "width": 30,
                  "children": [
                    {
                      "type": "shape",
                      "fill": "token:surface3",
                      "cornerRadius": 2,
                      "stroke": "token:borderDefault",
                      "strokeThickness": 1
                    },
                    {
                      "type": "image",
                      "slot": "profile.identity.cover",
                      "stretch": "uniform-to-fill",
                      "ambient": true,
                      "width": 30,
                      "height": 30,
                      "hAlign": "left",
                      "vAlign": "center",
                      "cornerRadius": 2,
                      "shape": "cover-shape",
                      "fallback": "none"
                    },
                    {
                      "type": "stack",
                      "spacing": 0,
                      "children": [
                        {
                          "type": "image",
                          "slot": "profile.identity.cover",
                          "stretch": "uniform-to-fill",
                          "width": 30,
                          "height": 30,
                          "hAlign": "left",
                          "vAlign": "center",
                          "cornerRadius": 2,
                          "shape": "cover-shape",
                          "fallback": "none"
                        }
                      ],
                      "opacity": 0,
                      "vAlign": "center"
                    }
                  ],
                  "hAlign": "left"
                },
                {
                  "type": "stack",
                  "column": 1,
                  "spacing": 0,
                  "children": [
                    {
                      "type": "text",
                      "slot": "profile.identity.name",
                      "role": "card-title",
                      "maxLines": 1,
                      "color": "token:textPrimary"
                    },
                    {
                      "type": "text",
                      "slot": "profile.identity.category",
                      "role": "micro",
                      "maxLines": 1,
                      "color": "token:textSecondary",
                      "visibleWhen": "profile.identity.category"
                    },
                    {
                      "type": "stack",
                      "orientation": "horizontal",
                      "spacing": 4,
                      "children": [
                        {
                          "type": "badge",
                          "slot": "profile.identity.rating",
                          "style": "text",
                          "visibleWhen": "profile.identity.rating"
                        },
                        {
                          "type": "text",
                          "slot": "profile.statistics.media-count",
                          "role": "badge",
                          "maxLines": 1,
                          "color": "token:textSecondary"
                        },
                        {
                          "type": "badge",
                          "slot": "profile.identity.favorite",
                          "style": "text",
                          "visibleWhen": "profile.identity.favorite"
                        }
                      ]
                    }
                  ],
                  "opacity": 0,
                  "vAlign": "center"
                }
              ],
              "row": 1
