    {
      "id": "naut.overworld-expedition.controls-blockcraft",
      "kind": "control-skin",
      "name": "Blockcraft Controls",
      "description": "Compact square controls with distinct hover, press and keyboard focus.",
      "previewAccent": "#FF476338",
      "spec": {
        "height": 30,
        "radius": 2,
        "pressedFill": "token:surfacePressed",
        "fill": "token:surface2",
        "scrollbarWidth": 7,
        "verticalPadding": 4,
        "hoverFill": "token:surfaceHover",
        "borderWidth": 1,
        "horizontalPadding": 10,
        "border": "token:borderDefault",
        "focus": "token:focus"
      }
    },
    {
      "id": "naut.overworld-expedition.home-base-camp",
      "kind": "home-layout",
      "name": "Base Camp",
      "description": "A still split hero, favorites and recent finds with compact activity and statistics.",
      "previewAccent": "#FF476338",
      "spec": {
        "hero": {
          "placement": "split",
          "heightFraction": 0.34,
          "minHeight": 200,
          "maxHeight": 340
        },
        "rails": [
          {
            "id": "statistics",
            "style": "strip",
            "maxItems": 4
          },
          {
            "id": "favorites",
            "style": "poster",
            "maxItems": 8
          },
          {
            "id": "recent",
            "style": "tile",
            "maxItems": 8
          },
          {
            "id": "activity",
            "style": "compact",
            "maxItems": 5
          },
          {
            "id": "attention",
            "style": "compact",
            "maxItems": 3
          }
        ],
        "surface": {
          "type": "stack",
          "spacing": 12,
          "children": [
            {
              "type": "semantic",
              "id": "featured"
            },
            {
              "type": "semantic",
              "id": "statistics"
            },
            {
              "type": "semantic",
              "id": "favorites"
            },
            {
              "type": "columns",
              "columns": [
                "2*",
                "*"
              ],
              "spacing": 16,
              "children": [
                {
                  "type": "semantic",
                  "id": "recent"
                },
                {
                  "type": "stack",
                  "spacing": 12,
                  "children": [
                    {
                      "type": "semantic",
                      "id": "activity"
                    },
                    {
                      "type": "semantic",
                      "id": "attention"
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    {
      "id": "naut.overworld-expedition.spotlight-trailhead",
      "kind": "spotlight-style",
      "name": "Trailhead Spotlight",
      "description": "Still artwork, framed portrait and concise identity without an overview.",
      "previewAccent": "#FF476338",
      "spec": {
        "showCover": true,
        "showOverview": false,
        "scrimStrength": 0.7,
        "motion": "still",
        "pagination": "counter",
        "transition": "fade",
        "rotationSeconds": 30,
        "composition": "split-glass"
      }
    },
    {
      "id": "naut.overworld-expedition.gallery-trophy-shelves",
      "kind": "gallery-layout",
      "name": "Trophy Shelves",
      "description": "A regular compact wall of collection cards with even spacing.",
      "previewAccent": "#FF476338",
      "spec": {
        "itemMaxWidth": 240,
        "maxColumns": 8,
        "itemMinWidth": 200,
        "spacing": 10,
        "toolbar": "catalog",
        "rowHeight": 300,
        "primitive": "VirtualizedUniformGrid"
      }
    },
    {
      "id": "naut.overworld-expedition.card-keepsake",
      "kind": "profile-card",
      "name": "Keepsake Card",
      "description": "Large framed portrait over a readable name, compact tags and rating.",
      "previewAccent": "#FF476338",
      "spec": {
        "legacyVariant": "prestige",
        "aspect": 0.7,
        "art": "cover-over-banner",
        "density": "detailed",
        "hover": "lift",
        "frame": "full",
        "composition": {
          "type": "overlay",
          "children": [
            {
              "cornerRadius": 2,
              "stroke": "token:borderStrong",
              "fill": "token:surfaceElevated",
              "strokeThickness": 2,
              "type": "shape"
            },
            {
              "spacing": 6,
              "padding": 12,
              "children": [
                {
                  "hAlign": "center",
                  "size": 144,
                  "type": "frame"
                },
                {
                  "align": "center",
                  "color": "token:textPrimary",
                  "type": "text",
                  "slot": "profile.identity.name",
                  "role": "card-title",
                  "maxLines": 2
                },
                {
                  "visibleWhen": "profile.identity.category",
                  "align": "center",
                  "color": "token:textSecondary",
                  "type": "text",
                  "slot": "profile.identity.category",
                  "role": "micro",
                  "maxLines": 1
                },
                {
                  "hAlign": "center",
                  "style": "outline",
                  "visibleWhen": "profile.identity.rating",
                  "slot": "profile.identity.rating",
                  "type": "badge"
                }
              ],
              "vAlign": "center",
              "type": "stack"
            },
            {
              "style": "text",
              "visibleWhen": "profile.identity.favorite",
              "type": "badge",
              "slot": "profile.identity.favorite",
              "hAlign": "right",
              "margin": 8,
              "vAlign": "top"
            }
          ]
        }
      }
    },
    {
      "id": "naut.overworld-expedition.profile-collection-lodge",
      "kind": "profile-layout",
      "name": "Collection Lodge",
      "description": "Compact identity followed by the full-width media wall; Delete stays in the final actions section.",
      "previewAccent": "#FF476338",
      "spec": {
        "preset": "compact-hero",
        "surface": {
          "spacing": 12,
          "children": [
            {
              "id": "identity",
              "type": "semantic"
            },
            {
              "id": "media",
              "type": "semantic"
            },
            {
              "id": "overview",
              "type": "semantic"
            },
            {
              "spacing": 12,
              "children": [
                {
                  "id": "related",
                  "type": "semantic"
                },
                {
                  "id": "faces",
                  "type": "semantic"
                }
              ],
              "columns": [
                "*",
                "*"
              ],
              "type": "columns"
            },
            {
              "id": "review",
              "type": "semantic"
            },
            {
              "id": "actions",
              "type": "semantic"
            }
          ],
          "type": "stack"
        }
      }
    },
    {
      "id": "naut.overworld-expedition.media-display-crates",
      "kind": "profile-media-layout",
      "name": "Display Crates",
      "description": "Square framed media tiles with names and useful metadata below.",
      "previewAccent": "#FF476338",
      "spec": {
        "metadataPlacement": "below",
        "frameStyle": "double",
