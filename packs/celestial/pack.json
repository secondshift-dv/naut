    {
      "id": "neuterradise.celestial.home-observatory",
      "kind": "home-layout",
      "name": "Observatory",
      "description": "Compact cinematic hero, collection rails and a quiet activity column.",
      "previewAccent": "#FFA78BFA",
      "spec": {
        "hero": {
          "placement": "inset",
