            "id": "statistics",
            "style": "strip",
            "maxItems": 4
          },
          {
            "id": "favorites",
            "style": "poster",
            "maxItems": 8
          },
          {
            "id": "recent",
            "style": "tile",
            "maxItems": 8
          },
          {
            "id": "activity",
            "style": "compact",
            "maxItems": 5
          },
          {
            "id": "attention",
            "style": "compact",
            "maxItems": 3
          }
        ],
        "surface": {
          "type": "stack",
          "spacing": 16,
          "children": [
            {
              "type": "semantic",
              "id": "featured"
            },
            {
              "type": "semantic",
              "id": "statistics"
            },
            {
              "type": "semantic",
              "id": "favorites"
            },
            {
              "type": "columns",
              "columns": [
                "2*",
                "*"
              ],
              "spacing": 16,
              "children": [
                {
                  "type": "semantic",
                  "id": "recent"
                },
                {
                  "type": "stack",
                  "spacing": 12,
                  "children": [
                    {
                      "type": "semantic",
                      "id": "activity"
                    },
                    {
                      "type": "semantic",
                      "id": "attention"
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    {
      "id": "neuterradise.celestial.gallery-constellation",
      "kind": "gallery-layout",
      "name": "Constellation Wall",
      "description": "A balanced portrait wall with close spacing; each Profile keeps its own card.",
      "previewAccent": "#FFA78BFA",
      "spec": {
        "primitive": "VirtualizedUniformGrid",
        "itemMinWidth": 180,
        "itemMaxWidth": 236,
        "spacing": 12,
        "maxColumns": 10,
        "rowHeight": 288
      }
    },
    {
      "id": "neuterradise.celestial.card-relic",
      "kind": "profile-card",
      "name": "Celestial Relic",
      "description": "Centered portrait and frame, readable identity, compact tags and rating.",
      "previewAccent": "#FFA78BFA",
      "spec": {
        "legacyVariant": "prestige",
        "aspect": 0.78,
        "art": "cover-over-banner",
        "density": "detailed",
        "hover": "spotlight",
        "frame": "full",
        "composition": {
          "type": "overlay",
          "children": [
            {
              "type": "shape",
              "fill": "token:surface1"
            },
            {
              "type": "image",
              "slot": "profile.identity.banner",
              "stretch": "uniform-to-fill",
              "ambient": true,
              "opacity": 0.1
            },
            {
              "type": "stack",
              "spacing": 6,
              "children": [
                {
                  "type": "frame",
                  "size": 104,
                  "hAlign": "center"
                },
                {
                  "type": "text",
                  "slot": "profile.identity.name",
                  "role": "card-title",
                  "color": "token:textPrimary",
                  "maxLines": 2,
                  "align": "center"
                },
                {
                  "type": "text",
                  "slot": "profile.identity.category",
                  "role": "micro",
                  "color": "token:textSecondary",
                  "maxLines": 1,
                  "visibleWhen": "profile.identity.category",
                  "align": "center"
                },
                {
                  "type": "text",
                  "slot": "profile.identity.tags",
                  "role": "micro",
                  "color": "token:textSecondary",
                  "maxLines": 1,
                  "visibleWhen": "profile.identity.tags",
                  "align": "center"
                },
                {
                  "type": "badge",
                  "slot": "profile.identity.rating",
                  "style": "outline",
                  "visibleWhen": "profile.identity.rating",
                  "hAlign": "center"
                }
              ],
              "padding": 12,
              "vAlign": "center"
            },
            {
              "type": "badge",
              "slot": "profile.identity.favorite",
              "style": "text",
              "visibleWhen": "profile.identity.favorite",
              "hAlign": "right",
              "vAlign": "top",
              "margin": 8
            }
          ]
        }
      }
    },
    {
      "id": "neuterradise.celestial.profile-sanctuary",
      "kind": "profile-layout",
      "name": "Sanctuary",
      "description": "Identity and actions first, balanced context columns, then the media collection.",
      "previewAccent": "#FFA78BFA",
      "spec": {
        "preset": "cinematic",
