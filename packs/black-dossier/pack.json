      "name": "Dossier Wall",
      "description": "Even virtualized cards with a separate widescreen Banner area and framed Cover identity.",
      "previewAccent": "#FFB72739",
      "spec": {
        "primitive": "VirtualizedUniformGrid",
        "itemMinWidth": 260,
        "itemMaxWidth": 340,
        "itemAspect": 1.0,
        "spacing": 18,
        "rowHeight": 280,
        "maxColumns": 6,
        "toolbar": "catalog"
      }
