    {
      "id": "naut.black-dossier.spotlight",
      "kind": "spotlight-style",
      "name": "Opening Brief",
      "description": "A cinematic left-aligned feature, framed Cover, readable overview and restrained still motion.",
      "previewAccent": "#FFB72739",
      "spec": {
        "composition": "cinematic-left",
        "motion": "still",
        "transition": "fade",
        "rotationSeconds": 30,
        "showCover": true,
        "showOverview": true,
        "pagination": "counter-rail",
        "scrimStrength": 0.78
      }
    },
    {
      "id": "naut.black-dossier.gallery",
