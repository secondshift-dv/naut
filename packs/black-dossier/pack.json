      "spec": {
        "legacyVariant": "prestige",
        "aspect": 1.0,
        "art": "cover-over-banner",
        "density": "detailed",
        "hover": "banner",
        "frame": "full",
        "composition": {
          "type": "overlay",
          "children": [
            {
              "type": "shape",
              "fill": "token:surface1",
              "stroke": "token:borderDefault",
              "strokeThickness": 1,
              "cornerRadius": 3
            },
            {
              "type": "grid",
              "rows": [
                "*",
                "124"
              ],
              "columns": [
                "*"
              ],
              "children": [
                {
                  "type": "overlay",
                  "row": 0,
                  "children": [
                    {
                      "type": "shape",
