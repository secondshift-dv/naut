                      "stretch": "uniform-to-fill",
                      "fallback": "none"
                    },
                    {
                      "type": "scrim",
                      "direction": "to-top",
                      "from": "#CC08090B",
                      "to": "#00000000"
                    },
                    {
                      "type": "badge",
                      "slot": "profile.identity.favorite",
                      "style": "solid",
                      "visibleWhen": "profile.identity.favorite",
                      "hAlign": "right",
                      "vAlign": "top",
                      "margin": 12
                    }
                  ]
                },
                {
                  "type": "grid",
                  "row": 1,
                  "columns": [
                    "96",
                    "*"
                  ],
                  "rows": [
                    "*"
                  ],
                  "spacing": 12,
                  "margin": 12,
                  "children": [
                    {
                      "type": "frame",
                      "size": 96,
                      "hAlign": "left",
                      "vAlign": "center"
                    },
                    {
                      "type": "stack",
                      "column": 1,
                      "spacing": 6,
                      "vAlign": "center",
                      "children": [
                        {
                          "type": "text",
                          "slot": "profile.identity.name",
                          "role": "card-title",
                          "color": "token:textPrimary",
                          "maxLines": 2
                        },
                        {
                          "type": "text",
                          "slot": "profile.identity.category",
                          "role": "micro",
                          "color": "token:textSecondary",
                          "maxLines": 1,
                          "visibleWhen": "profile.identity.category"
                        },
                        {
                          "type": "badge",
                          "slot": "profile.identity.rating",
                          "style": "outline",
                          "visibleWhen": "profile.identity.rating",
                          "hAlign": "left"
